{
  "name": "@projects27/api",
  "version": "0.1.0",
  "private": true,
  "description": "Projects 27 core API: one contract for the web, iOS and Android clients",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "start": "node src/server.ts",
    "migrate": "node src/migrate.ts",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file=.env src/server.ts",
    "migrate:dev": "node --env-file=.env src/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "^7.0.2"
  }
}
