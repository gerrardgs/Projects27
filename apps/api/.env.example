# Copy to .env (never commit .env). All values below are placeholders for local development.

# PostgreSQL 18 connection string.
DATABASE_URL=postgres://localhost:5433/projects27_dev

# Port the API listens on.
PORT=8080

# 32 random bytes, base64. Encrypts TOTP seeds at rest. Generate with: openssl rand -base64 32
TOTP_KEY=

# Comma-separated origins of the web app allowed to call the API with cookies (exact origins, no paths).
WEB_ORIGINS=http://localhost:5173

# Only "false" disables the Secure cookie flag and HSTS, for plain-HTTP local development.
COOKIE_SECURE=false

# Sign-in and registration attempts per client address per minute.
AUTH_ATTEMPTS_PER_MINUTE=10

# Optional: Claude API key for voice and text capture (POST .../capture/parse). Without it the built-in
# Indonesian rule parser fills the form. Sentences sent to the model contain transaction details only.
ANTHROPIC_API_KEY=
# Model for capture; the default is claude-opus-5-5.
CAPTURE_AI_MODEL=claude-opus-5-5
