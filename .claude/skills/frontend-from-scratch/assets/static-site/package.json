{
  "name": "static-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint styles.css",
