# Copy to the repository root as .env.example and commit it. Copy it to .env (git-ignored) for local use.
# List every variable the application reads. Never put real secrets in this file.

# Runtime
PORT=3000
LOG_LEVEL=info

# Backing services (example values only)
DATABASE_URL=postgres://app:change-me@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Secrets: set real values in .env locally and in the secret manager in deployed environments
SESSION_SECRET=
API_TOKEN=
